# CourtVision AI configuration.
#
# Copy this file to `.env` and fill in what you need:
#     cp .env.example .env
#
# `.env` is gitignored, so your keys never leave your machine. Both the local
# backend and `docker compose` read this same file. Real environment variables
# (exports, CI, Docker) override anything set here.

# ---------------------------------------------------------------------------
# AI features (the Ask page and scouting reports)
# ---------------------------------------------------------------------------
# Set ONE of these. If several are present, the first one found wins, in the
# order listed here. Leave them all blank to run without AI: every other page
# works normally and the AI endpoints report that they are not configured.

# Google Gemini — free tier available at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Force a specific provider when more than one key is set: gemini | anthropic | openai
COURTVISION_LLM=

# Use a different model than the per-provider default
# (defaults live in DEFAULT_MODELS in src/courtvision/ai/llm.py)
COURTVISION_LLM_MODEL=

# ---------------------------------------------------------------------------
# Paths and modes (optional, sensible defaults if left blank)
# ---------------------------------------------------------------------------
# Where the analytics database lives. Default: data/courtvision.duckdb
COURTVISION_DB=

# Where trained model files live. Default: data/models
COURTVISION_MODELS=

# Set to 1 to start with realistic synthetic data instead of real NBA data,
# useful for a demo before you have run the ingestion script.
COURTVISION_DEMO=
